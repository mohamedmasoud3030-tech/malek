{
  "name": "@workspace/rentrix",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts --host 0.0.0.0",
    "build": "node scripts/write-build-proof.mjs && vite build --config vite.config.ts",
    "serve": "vite preview --config vite.config.ts --host 0.0.0.0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run --config vite.config.ts --exclude src/components/ui/primitives.axe.test.tsx",
    "test:a11y-primitives": "vitest run --config vite.config.ts src/components/ui/primitives.axe.test.tsx",
    "lint": "tsc -p tsconfig.json --noEmit",
    "check:architecture": "node scripts/check-architecture.mjs && node scripts/check-active-register-inventory.mjs && node --test scripts/check-active-register-inventory.test.mjs",
    "check:enterprise-freeze": "node ../scripts/check-no-new-enterprise-usage.mjs",
    "test:financials": "vitest run --config vite.config.ts --dir src/features/financials",
    "e2e": "playwright test --config playwright.config.ts",
    "e2e:headed": "playwright test --config playwright.config.ts --headed",
    "test:frontend-db-contract": "node --test scripts/check-frontend-db-contract.test.mjs",
    "check:frontend-db-contract": "node scripts/run-frontend-db-contract-tests.mjs",
    "test:frontend-backend-runtime-contract": "vitest run --config vite.config.ts src/test/db-contract/invoice-payment-safety-contract.test.ts src/features/financials/payments/paymentService.test.ts src/features/financials/collections-payments-period-close.pglite.test.ts src/features/financials/phase1-omr-precision-reconciliation.test.ts src/features/owners/services/owner-settlements-service.p1.test.ts src/features/lifecycle/core-operational-journey.test.ts src/features/lifecycle/product-workflow-scenarios.test.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@hookform/resolvers": "^3.10.0",
    "@playwright/test": "1.61.1",
    "@radix-ui/primitive": "^1.1.3",
    "@radix-ui/react-dialog": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.0",
    "@replit/vite-plugin-cartographer": "catalog:",
    "@replit/vite-plugin-dev-banner": "catalog:",
    "@replit/vite-plugin-runtime-error-modal": "catalog:",
    "@tailwindcss/postcss": "^4.1.14",
    "@tanstack/react-query": "catalog:",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-v8": "3.2.7",
    "autoprefixer": "^10.5.0",
    "axe-core": "4.12.1",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "date-fns": "^3.6.0",
    "framer-motion": "catalog:",
    "happy-dom": "^20.10.6",
    "lucide-react": "catalog:",
    "postcss": "^8.5.13",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-hook-form": "^7.55.0",
    "recharts": "^2.15.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "catalog:",
    "tailwindcss": "catalog:",
    "vite": "catalog:",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "3.2.7",
    "zod": "catalog:"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.105.1",
    "@tanstack/react-router": "^1.139.3",
    "@tanstack/react-router-devtools": "^1.139.3",
    "html2canvas-pro": "^2.2.4",
    "jspdf": "^4.2.1",
    "sonner": "^2.0.7",
    "workbox-window": "^7.4.1",
    "zustand": "^5.0.8"
  }
}
