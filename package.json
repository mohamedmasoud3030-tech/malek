{
  "name": "rentrix-production-workspace",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@10.11.1",
  "engines": {
    "pnpm": "10.11.1"
  },
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "install:clean": "pnpm install --frozen-lockfile",
    "build": "pnpm --filter @workspace/rentrix run build",
    "typecheck": "tsc -b && pnpm --filter @workspace/rentrix run typecheck",
    "lint": "pnpm --filter @workspace/rentrix run lint",
    "check:docs": "node scripts/check-doc-links.mjs",
    "check:business-rules": "node scripts/check-canonical-business-rules.mjs",
    "check:execution-plan": "node scripts/check-10-stage-execution-plan.mjs",
    "check:migration-hygiene": "node scripts/check-migration-rollback-hygiene.mjs",
    "test:migration-hygiene": "node scripts/check-migration-rollback-hygiene.test.mjs",
    "check:enterprise-freeze": "node scripts/check-no-new-enterprise-usage.mjs",
    "test:enterprise-freeze": "node scripts/check-no-new-enterprise-usage.test.mjs",
    "check:gl-write-boundary": "node scripts/check-no-new-legacy-journal-writes.mjs",
    "test:gl-write-boundary": "node scripts/check-no-new-legacy-journal-writes.test.mjs",
    "supabase:migration-evidence": "bash scripts/collect-supabase-migration-evidence.sh",
    "check:expired-flags": "node scripts/check-expired-flags.mjs",
    "db0:replay": "node scripts/db0/replay-migrations.mjs --all",
    "db0:audit": "node scripts/db0/audit.mjs",
    "db0:gen-types": "node scripts/db0/gen-types.mjs",
    "db0:check-types": "node scripts/db0/gen-types.mjs --check",
    "db0:idempotency": "node scripts/db0/check-idempotency.mjs",
    "db0:isolation": "node scripts/db0/check-isolation.mjs",
    "db0:contract": "node scripts/db0/check-contract.mjs",
    "db0:gate": "node scripts/db0/gate.mjs",
    "db:guardian": "node scripts/guardian/run.mjs",
    "db:guardian:governance": "node scripts/guardian/governance.mjs",
    "test:supabase": "node scripts/supabase-tests/run.mjs",
    "test:supabase:rls": "node scripts/supabase-tests/rls-matrix.mjs",
    "test:supabase:secrets": "node scripts/supabase-tests/privileged-key-scan.mjs",
    "qa:preflight": "node scripts/agent-qa-preflight.mjs",
    "qa:database-contracts": "bash scripts/verify-agent-qa-database-contracts.sh",
    "qa:lifecycle": "bash scripts/run-agent-qa-lifecycle.sh",
    "pilot:seed": "pnpm --filter ./rentrix-app exec node scripts/pilot-demo-seed.mjs",
    "test:pilot-seed": "node --test rentrix-app/scripts/pilot-demo-seed.test.mjs",
    "test:qa-runtime": "node --test scripts/agent-qa-preflight.test.mjs",
    "e2e": "pnpm --filter @workspace/rentrix run e2e",
    "e2e:install": "pnpm --filter @workspace/rentrix exec playwright install --with-deps chromium",
    "supabase:live-readiness": "bash scripts/verify-supabase-live-readiness.sh",
    "test": "pnpm --filter @workspace/rentrix run test"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "prettier": "^3.8.1",
    "supabase": "2.105.0",
    "typescript": "~5.9.2"
  },
  "dependencies": {
    "@vercel/speed-insights": "^2.0.0"
  },
  "pnpm": {
    "overrides": {
      "dompurify": ">=3.4.13",
      "ws": ">=8.21.0"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "core-js",
      "supabase"
    ]
  }
}
