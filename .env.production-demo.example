# MALEK Production URL — presentation/demo backend profile.
# Copy these names into Vercel Production environment settings only.
# Never commit real passwords or privileged service-role credentials here.

# The public production URL is intentionally a presentation surface for now.
MALEK_DEPLOYMENT_PROFILE=production-demo
PRODUCTION_DEMO_APPROVED=1

# Canonical live MALEK project — comparison only. The preflight refuses this target.
PRODUCTION_SUPABASE_PROJECT_REF=nnggcnpcuomwfuupupwg

# A physically separate Supabase project/branch dedicated to the sales/demo dataset.
DEMO_SUPABASE_PROJECT_REF=replace-with-dedicated-demo-project-ref
VITE_SUPABASE_URL=https://replace-with-dedicated-demo-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=replace-with-demo-publishable-or-anon-key

# Public parent-brand origin.
VITE_LENA_HOUSE_ORIGIN=https://lenadigital.vercel.app
