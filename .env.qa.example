# Dedicated hosted QA only — copy to an untracked secret store, never commit real values.
QA_ENVIRONMENT_KIND=qa
QA_SUPABASE_PROJECT_REF=your-qa-project-ref
PRODUCTION_SUPABASE_PROJECT_REF=your-production-project-ref

# Public Supabase connection values for the QA deployment.
VITE_SUPABASE_URL=https://your-qa-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-qa-publishable-or-anon-key

# Read-only preflight identity. It needs an active company_members row and JWT company_id claim.
QA_ADMIN_EMAIL=qa-admin@example.invalid
QA_ADMIN_PASSWORD=replace-with-qa-admin-password

# Explicitly disposable identity used only by qa:lifecycle.
E2E_ENVIRONMENT_KIND=qa
E2E_SINGLE_OFFICE_EMAIL=qa-single-office@example.invalid
E2E_SINGLE_OFFICE_PASSWORD=replace-with-disposable-qa-password

# QA-only privileged/read-only runtime credentials. Never prefix these with VITE_.
SUPABASE_SERVICE_ROLE_KEY=replace-with-qa-service-role-key
SUPABASE_DB_URL=postgresql://readonly-qa-user:password@host:5432/postgres

# Keep unset by default. Set exactly to 1 only in the secret runtime immediately before qa:lifecycle.
# QA_MUTATION_APPROVED=1

# Stable independent parent-brand production origin
VITE_LENA_HOUSE_ORIGIN=https://lenadigital.vercel.app
